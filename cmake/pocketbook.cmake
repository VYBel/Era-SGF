set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7a)
if(NOT DEFINED ENV{POCKETBOOK_SDK})
    message(FATAL_ERROR "Set POCKETBOOK_SDK to the extracted SDK-B288 directory")
endif()
get_filename_component(_sdk "$ENV{POCKETBOOK_SDK}" REALPATH)
set(CMAKE_CXX_COMPILER "${_sdk}/usr/bin/arm-obreey-linux-gnueabi-g++")
set(CMAKE_SYSROOT "${_sdk}/usr/arm-obreey-linux-gnueabi/sysroot")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_PREFIX_PATH "${CMAKE_SYSROOT}/usr/local")
set(CMAKE_CXX_COMPILER_LAUNCHER "${CMAKE_COMMAND};-E;env;LD_LIBRARY_PATH=${_sdk}/usr/lib:$ENV{LD_LIBRARY_PATH}")
set(CMAKE_CXX_FLAGS_INIT "-DPLATFORM_FC -fsigned-char -march=armv7-a -mtune=cortex-a7 -mfpu=neon -mfloat-abi=softfp")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,-rpath-link,${CMAKE_SYSROOT}/usr/local/lib -Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib -Wl,-rpath-link,${CMAKE_SYSROOT}/ebrmain/lib")
set(ENV{LD_LIBRARY_PATH} "${_sdk}/usr/lib:$ENV{LD_LIBRARY_PATH}")
